{
  "name": "@ezwel/ui",
  "version": "1.5.2",
  "description": "현대이지웰 업무 시스템 공용 디자인 시스템 — 디자인 토큰과 Vue 3 컴포넌트",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./all.css": "./dist/all.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./layout.css": "./dist/layout.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node scripts/bundle-css.mjs",
    "prepare": "npm run build",
    "palette": "node scripts/generate-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:anchors": "npm run docs:build && node scripts/check-anchors.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-consumer.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify": "npm run check:contrast && npm run typecheck && npm run test && npm run build && npm run check:anchors",
    "sync:styleguide": "node scripts/sync-styleguide.mjs"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitepress": "^1.5.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyundaiezwel/ez-design-system.git"
  }
}
